<Window x:Class="WPFComboBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFComboBox"
        mc:Ignorable="d"
        Title="Student Learning Portal"
        Height="650" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8F3FF">

    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FAF8FF"/>
            <Setter Property="BorderBrush" Value="#E3D5F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border CornerRadius="28"
                Background="White"
                ClipToBounds="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT BRAND PANEL -->
                <Border Grid.Column="0" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#8E44AD" Offset="0"/>
                            <GradientStop Color="#E84393" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Background="#40FFFFFF"
                                    CornerRadius="16"
                                    Width="65" Height="65"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="✦"
                                           FontSize="38"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="LEARN."
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                            <TextBlock Text="GROW. ACHIEVE."
                                       Foreground="#FFE6F5"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Your Future&#10;Starts Here"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       LineHeight="43"/>

                            <TextBlock Text="Choose your learning path and build your skills one step at a time."
                                       FontSize="15"
                                       Foreground="#FFF0FA"
                                       TextWrapping="Wrap"
                                       LineHeight="25"
                                       Margin="0,18,0,0"/>

                            <Border Background="#35FFFFFF"
                                    CornerRadius="14"
                                    Padding="15"
                                    Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="✦  PERSONALIZED LEARNING"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Select courses that match your goals."
                                               Foreground="White"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Text="STUDENT PORTAL  •  2026"
                                   Foreground="#FFF0FA"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- RIGHT FORM PANEL -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="35,28,35,25">

                        <TextBlock Text="Student Registration"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#35234A"/>

                        <TextBlock Text="Fill in your details to get started."
                                   FontSize="14"
                                   Foreground="#8A7D96"
                                   Margin="0,7,0,25"/>

                        <TextBlock Text="01  PERSONAL DETAILS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A05ACB"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Full Name"
                                   FontWeight="SemiBold"
                                   Foreground="#493A57"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="txtName"
                                 Style="{StaticResource FieldBox}"
                                 ToolTip="Enter your full name"
                                 Margin="0,0,0,20"/>

                        <TextBlock Text="02  COURSE SELECTION"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A05ACB"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Choose Your Course"
                                   FontWeight="SemiBold"
                                   Foreground="#493A57"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="cmbCourse"
                                  Height="43"
                                  FontSize="15"
                                  Padding="10,8"
                                  Background="#FAF8FF"
                                  BorderBrush="#E3D5F5"
                                  SelectedIndex="0"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="C# Programming"/>
                            <ComboBoxItem Content="SQL Server"/>
                            <ComboBoxItem Content="WPF Development"/>
                            <ComboBoxItem Content="ASP.NET Core"/>
                            <ComboBoxItem Content="HTML and CSS"/>
                        </ComboBox>

                        <TextBlock Text="03  SKILLS &amp; SUBJECTS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A05ACB"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Select the subjects you know"
                                   FontWeight="SemiBold"
                                   Foreground="#493A57"
                                   Margin="0,0,0,7"/>

                        <Border BorderBrush="#E3D5F5"
                                BorderThickness="1"
                                Background="#FAF8FF"
                                CornerRadius="12"
                                Padding="8"
                                Margin="0,0,0,25">
                            <ListBox x:Name="lstSubjects"
                                     Height="115"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     SelectionMode="Multiple">
                                <ListBoxItem Content="C# Programming" Padding="8"/>
                                <ListBoxItem Content="SQL Server" Padding="8"/>
                                <ListBoxItem Content="XAML" Padding="8"/>
                                <ListBoxItem Content="HTML and CSS" Padding="8"/>
                                <ListBoxItem Content="ASP.NET Core" Padding="8"/>
                            </ListBox>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="✓   Submit Details"
                                    x:Name="btnSubmit"
                                    Style="{StaticResource ActionButton}"
                                    Background="#9146C8"
                                    Foreground="White"
                                    Click="BtnSubmit_Click"/>

                            <Button Grid.Column="2"
                                    Content="↺   Clear Form"
                                    x:Name="btnClear"
                                    Style="{StaticResource ActionButton}"
                                    Background="#F3E8FF"
                                    Foreground="#7841A5"
                                    Click="BtnClear_Click"/>
                        </Grid>

                        <TextBlock Text="Your learning journey begins today ✨"
                                   FontSize="12"
                                   Foreground="#A093AD"
                                   HorizontalAlignment="Center"
                                   Margin="0,22,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>


