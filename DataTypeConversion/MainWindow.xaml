<Window x:Class="DataTypeConversion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataTypeConversion"
        mc:Ignorable="d"
        Title="Data Type Conversion"
        Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3EEFF">

        <Grid Margin="25">
            <Border Background="White"
                CornerRadius="22"
                Padding="30">

                <StackPanel>
                    <TextBlock Text="DATA TYPE CONVERSION"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#7542A8"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Convert values between different data types"
                           FontSize="14"
                           Foreground="#887B98"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,25"/>

                    <TextBlock Text="Enter a Value"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,7"/>

                    <TextBox x:Name="txtInput"
                         Height="42"
                         FontSize="16"
                         Padding="10"
                         BorderBrush="#D9C5F0"
                         ToolTip="Enter a number or text"
                         Margin="0,0,0,18"/>

                    <TextBlock Text="Select Conversion Type"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,7"/>

                    <ComboBox x:Name="cmbConversion"
                          Height="42"
                          FontSize="15"
                          Padding="8"
                          SelectedIndex="0"
                          BorderBrush="#D9C5F0"
                          Margin="0,0,0,22">
                        <ComboBoxItem Content="String to Integer"/>
                        <ComboBoxItem Content="String to Double"/>
                        <ComboBoxItem Content="Integer to String"/>
                        <ComboBoxItem Content="Double to Integer"/>
                        <ComboBoxItem Content="Integer to Double"/>
                    </ComboBox>

                    <Button Content="Convert Value"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#854BC5"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnConvert_Click"/>

                    <Border Background="#F7F1FF"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="CONVERSION RESULT"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#9B79B8"/>

                            <TextBlock x:Name="txtResult"
                                   Text="Your result will appear here"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#543274"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Clear"
                        Height="40"
                        Width="120"
                        HorizontalAlignment="Center"
                        Background="LightPink"
                        Foreground="#7542A8"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Margin="0,18,0,0"
                        Click="BtnClear_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Window>

