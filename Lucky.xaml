<Window x:Class="FirstApp.Lucky"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstApp"
        mc:Ignorable="d"
        Title="Lucky" Height="450" Width="800">
    <StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btn1" Click="btn1_Click" Tag="100" Content="1" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn2" Click="btn2_Click" Tag="0" Content="2" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn3" Click="btn3_Click" Tag="1000" Content="3" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn4" Click="btn4_Click" Tag="10" Content="4" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btn5" Click="btn5_Click" Tag="70" Content="1" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn6" Click="btn6_Click" Tag="60" Content="6" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn7" Click="btn7_Click" Tag="40" Content="7" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn8" Click="btn8_Click" Tag="0" Content="8" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btn9" Click="btn9_Click" Tag="30" Content="9" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn10" Click="btn10_Click" Tag="50" Content="10" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn11" Click="btn11_Click" Tag="14" Content="11" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
            <Button Name="btn12" Click="btn12_Click" Tag="26" Content="12" Margin="5" FontWeight="Bold" Width="100" Height="80" FontSize="20" BorderThickness="0" Background="LightBlue"></Button>
        </StackPanel>
            
    </StackPanel>
</Window>
